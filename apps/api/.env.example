# Postgres connection string.
# Leave unset for local dev — the API falls back to an in-memory repo.
# Production: Neon, Supabase, or any Postgres-compatible URL works.
DATABASE_URL=

# Comma-separated list of origins allowed to call the API (no trailing slash).
# Dev: http://localhost:5173
# Production: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# Port the Node server binds to.
PORT=8787
